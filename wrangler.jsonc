{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "affiliate-content-automation",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": []
  },
  "vars": {
    "SUPABASE_URL": "https://elxzvlbqsodsgygopsxw.supabase.co",
    "DEFAULT_TIMEZONE": "America/Sao_Paulo",
    "WORKER_BATCH_SIZE": "10",
    "WORKER_MAX_BATCHES": "2",
    "PUBLISH_DELAY_MS": "1000"
  }
}
